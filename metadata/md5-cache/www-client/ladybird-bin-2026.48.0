RDEPEND=!www-client/ladybird app-misc/ca-certificates >=dev-libs/glib-2.79:2 >=dev-libs/wayland-1.20 media-fonts/liberation-fonts media-libs/libglvnd media-libs/libpulse >=media-libs/vulkan-loader-1.3.204 >=sys-devel/gcc-14:*[cxx] >=sys-libs/glibc-2.39 >=x11-libs/libX11-1.8.7 x11-libs/libdrm >=x11-libs/libxcb-1.15 x11-libs/libxkbcommon[X] x11-libs/xcb-util x11-libs/xcb-util-cursor x11-libs/xcb-util-image x11-libs/xcb-util-keysyms x11-libs/xcb-util-renderutil x11-libs/xcb-util-wm
