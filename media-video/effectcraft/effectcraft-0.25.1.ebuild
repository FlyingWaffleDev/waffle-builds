inherit cargo desktop xdg

DESCRIPTION="Open-source motion graphics and VFX compositor (After Effects alternative)"
HOMEPAGE="https://getartcraft.com/apps/effectcraft https://github.com/storytold/effectcraft"
SRC_URI="
	https://github.com/storytold/${PN}/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="|| ( Apache-2.0 MIT )"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD BSD-2 Boost-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 OFL-1.1 UoI-NCSA
	UbuntuFontLicense-1.0 Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="
	dev-libs/wayland
	media-libs/alsa-lib
	media-libs/fontconfig
	media-libs/vulkan-loader
	sys-apps/xdg-desktop-portal
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXi
	x11-libs/libXrandr
	x11-libs/libxcb
	x11-libs/libxkbcommon[X]
	x11-misc/xdg-utils
"
DEPEND="${RDEPEND}"
BDEPEND="
	virtual/pkgconfig
"

QA_FLAGS_IGNORED="usr/bin/${PN} usr/bin/${PN}-cli"

src_prepare() {
	default

	# Several Git revisions contain crates with identical names and versions.
	# Keep their lockfile identities with per-revision directory sources.
	local crate crate_uri commit crate_dir source_dir vendor_dir manifest
	local -A sources=()
	for crate in "${!GIT_CRATES[@]}"; do
		sed -i "/^${crate} = /d" "${ECARGO_HOME}/config.toml" || die
		IFS=';' read -r crate_uri commit crate_dir <<< "${GIT_CRATES[${crate}]}"
		crate_dir="${crate_dir//%commit%/${commit}}"
		source_dir="${WORKDIR}/${crate_dir%%/*}"
		crate_dir="${WORKDIR}/${crate_dir}"
		vendor_dir="${WORKDIR}/git-${commit}-vendor"
		mkdir -p "${vendor_dir}" || die
		manifest="${crate_dir}/Cargo.toml"
		# Directory sources must still find the original workspace for inheritance.
		if [[ ${crate_dir} != ${source_dir} ]] &&
			grep -Eq '(\.workspace[[:space:]]*=|workspace[[:space:]]*=[[:space:]]*true)' "${manifest}"; then
			sed -i "/^\[package\]/a workspace = \"${source_dir}\"" "${manifest}" || die
		fi
		printf '%s\n' '{"files":{},"package":null}' \
			> "${crate_dir}/.cargo-checksum.json" || die
		ln -s "${crate_dir}" "${vendor_dir}/${crate_dir##*/}" || die

		[[ ${sources[${commit}]} ]] && continue
		sources[${commit}]=1
		cat >> "${ECARGO_HOME}/config.toml" <<-EOF || die
			[source.git-${commit}]
			git = "${crate_uri}"
			rev = "${commit}"
			replace-with = "git-${commit}-vendor"

			[source.git-${commit}-vendor]
			directory = "${vendor_dir}"
		EOF
	done
}

src_configure() {
	cargo_src_configure --locked
}

src_compile() {
	cargo_src_compile --package ${PN} --package ${PN}-cli
}

src_install() {
	dobin "$(cargo_target_dir)/${PN}" "$(cargo_target_dir)/${PN}-cli"

	domenu "packaging/linux/ai.storyteller.${PN}.desktop"

	insinto /usr/share/mime/packages
	newins "packaging/linux/ai.storyteller.${PN}.mime.xml" "ai.storyteller.${PN}.xml"

	sed -e "s/@VERSION@/${PV}/g" -e "s/@DATE@/$(date +%Y-%m-%d)/g" \
		"packaging/linux/ai.storyteller.${PN}.metainfo.xml.in" > "${T}/ai.storyteller.${PN}.metainfo.xml" || die
	insinto /usr/share/metainfo
	doins "${T}/ai.storyteller.${PN}.metainfo.xml"

	insinto /usr/share/icons
	doins -r assets/app-icon/hicolor

	einstalldocs
}
